# ============================================================
# .env.example – SentinelX Trust AI
# Template for local development environment configuration
# Author: Niraj Kadam – DevOps & Engineering Operations
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the project root
#      cp .env.example .env
#   2. Fill in all required values marked with <CHANGE_ME>
#   3. NEVER commit your .env file to version control
# ============================================================


# ============================================================
# Scraper: Betting Site Credentials
# Used by: Niraj Kadam's Data Acquisition Engine
# ============================================================
USERNAME=<CHANGE_ME>
PASSWORD=<CHANGE_ME>

# ============================================================
# Scraper: Target URLs
# ============================================================
ONEXBET_URL=https://1xlite-12947.pro/en
MELBET_URL=https://melbet.com
TENCRIC_URL=https://10cric247.com
PLAY22_URL=https://22play.com

# ============================================================
# Scraper: Behaviour Configuration
# ============================================================
# Set HEADLESS=true inside Docker (required for containerized Chromium)
HEADLESS=true
WAIT_TIMEOUT=20
SCREENSHOT=false
TARGET_SITE=onexbet

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Observability & Monitoring Configuration
# ============================================================
ENABLE_METRICS=true
GF_ADMIN_PASSWORD=admin

# ============================================================
# Database: PostgreSQL
# Used by: Niraj Kadam (Backend) & Niraj Kadam (ETL)
# NOTE: DB_HOST must be 'postgres' when using Docker Compose
#       Use 'localhost' for running services directly on host
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<CHANGE_ME>
DB_NAME=sentinelx_trust_ai

# ============================================================
# pgAdmin (optional admin UI)
# Access at http://localhost:5050
# ============================================================
PGADMIN_EMAIL=admin@sentinelx.com
PGADMIN_PASSWORD=<CHANGE_ME>

# ============================================================
# JWT Authentication
# Used by: FastAPI Backend (Niraj Kadam)
# IMPORTANT: Change JWT_SECRET_KEY to a strong random value
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET_KEY=<CHANGE_ME_use_python_secrets_token_hex_32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# Seeded User Accounts (used for initial backend setup)
# ============================================================
ADMIN_EMAIL=admin@sentinelx.com
ADMIN_PASSWORD=<CHANGE_ME>
ANALYST_EMAIL=analyst@sentinelx.com
ANALYST_PASSWORD=<CHANGE_ME>
READER_EMAIL=reader@sentinelx.com
READER_PASSWORD=<CHANGE_ME>
